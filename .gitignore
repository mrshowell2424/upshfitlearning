# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Canvas source for the Basic Reading materials. The files the site actually
# serves are copied into public/reading/materials/, so tracking these too would
# put the same 20MB in the repo twice.
/Science of Reading/
/drive-download-*/

# Finder duplicates, e.g. "Basic Reading Lesson Filer copy.html"
*\ copy.html

# Working material sitting in the repo root: downloaded archives and scans.
# 432MB of it at the time of writing, none of it code, none of it ignored --
# so one `git add -A` would have staged the lot. The largest is a 416MB zip
# of third-party curriculum (Lexia, Wilson, Beck/McKeown/Kucan) which must
# not be published from here at all; GitHub's 100MB file ceiling was the
# only thing standing in the way, which is luck rather than a safeguard.
#
# Only archives and scans are listed. Loose .html stays visible in
# `git status` on purpose, so it keeps reminding you it is there.
/*.zip
/*.tif
/*.tiff
/*.pdf
/Books*/
