{
  "framework": "nextjs",
  "buildCache": {
    "enabled": true
  },
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": {
      "description": "Supabase project URL"
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "description": "Supabase anonymous key for client-side auth"
    },
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key for payment processing"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key for backend payments"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret"
    },
    "SUBSTACK_WEBHOOK_SECRET": {
      "description": "Substack webhook signing secret"
    },
    "DATABASE_URL": {
      "description": "Supabase PostgreSQL connection string"
    },
    "DATABASE_POOL_URL": {
      "description": "Supabase connection pooler for serverless"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Claude API key for lesson generation"
    },
    "GOOGLE_SHEETS_ID": {
      "description": "Google Sheets ID for resource syncing"
    },
    "GOOGLE_SERVICE_ACCOUNT_KEY": {
      "description": "Google service account credentials JSON"
    },
    "SENTRY_DSN": {
      "description": "Sentry error tracking DSN"
    },
    "SENTRY_ORG": {
      "description": "Sentry organization slug"
    },
    "SENTRY_PROJECT": {
      "description": "Sentry project slug"
    },
    "SENTRY_AUTH_TOKEN": {
      "description": "Sentry authentication token"
    }
  },
  "regions": [
    "iad1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "headers": [
    {
      "source": "/api/stripe/webhooks",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "X-Stripe-Signature",
          "value": "required"
        }
      ]
    },
    {
      "source": "/api/webhooks/substack",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [],
  "redirects": [],
  "functions": {
    "api/**/*.ts": {
      "memory": 3008,
      "maxDuration": 30
    }
  }
}
